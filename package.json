{
  "name": "padel-match",
  "version": "0.1.0",
  "private": true,
  "description": "PADEL MATCH — gestión de torneos de pádel",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "build:app": "next build",
    "start": "next start",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core/*.test.ts",
    "test:db": "tsx --test tests/db/*.test.ts",
    "backup": "node scripts/backup.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^15.5.7",
    "postgres": "^3.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@playwright/test": "^1.49.1"
  }
}
