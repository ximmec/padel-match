# Copiá este archivo como .env.local para desarrollo local.

# Conexión a PostgreSQL (en Vercel la crea la integración con Neon automáticamente)
DATABASE_URL=postgres://usuario:clave@localhost:5432/padel

# URL pública de la app (para enlaces y metadatos)
APP_URL=https://padel-match.net

# Opcional: clave que se pide en /setup para crear el primer administrador.
# Recomendado en producción hasta completar la configuración inicial.
SETUP_KEY=

# Zona horaria de la app (Argentina por defecto)
NEXT_PUBLIC_APP_TZ=America/Argentina/Buenos_Aires
NEXT_PUBLIC_APP_TZ_OFFSET=-03:00
